# ── Spend Insights Agent configuration ──────────────────────────────
# Copy to `.env` and adjust. Everything works with NO changes (offline mode).

# LLM provider: "offline" (default, no key needed) or "openai"
LLM_PROVIDER=offline

# Used only when LLM_PROVIDER=openai. Works with any OpenAI-compatible endpoint.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Retrieval
TOP_K=3

# Paths
DATA_DIR=data
TRACE_DIR=traces

# API
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional AgentOps tracing via LangFuse (leave blank to disable)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
